# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
JWT_SECRET=change_this_to_a_long_random_string_in_production
APP_URL=http://localhost:3000

# ─── Email Configuration ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The app works without email — if these are not set, emails are silently skipped
# and a message is printed to the console instead.

# ── Option 1: Gmail (easiest for personal use) ──────────────────────────────────
#
# Step 1: Enable 2-Factor Authentication on your Google account
#   https://myaccount.google.com/security
#
# Step 2: Create an App Password (NOT your real Gmail password)
#   https://myaccount.google.com/apppasswords
#   → Select app: Mail  → Select device: Other → name it "Zuno"
#   → Copy the 16-character password shown
#
# Step 3: Fill in below:
#
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop
EMAIL_FROM=Zuno eBikes <youraddress@gmail.com>

# ── Option 2: Brevo (formerly Sendinblue) — free tier: 300 emails/day ───────────
# Sign up free at https://app.brevo.com → SMTP & API → SMTP tab → copy credentials
#
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=your_brevo_login_email@example.com
# EMAIL_PASS=your_brevo_smtp_key
# EMAIL_FROM=Zuno eBikes <noreply@yourdomain.com>

# ── Option 3: SendGrid — free tier: 100 emails/day ──────────────────────────────
# Sign up at https://sendgrid.com → Settings → API Keys → create key
#
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=SG.your_sendgrid_api_key_here
# EMAIL_FROM=Zuno eBikes <noreply@yourdomain.com>

# ── Option 4: Resend — free tier: 100 emails/day ────────────────────────────────
# Sign up at https://resend.com → API Keys → create key
# Add and verify your sending domain in Resend dashboard first.
#
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USER=resend
# EMAIL_PASS=re_your_resend_api_key_here
# EMAIL_FROM=Zuno eBikes <noreply@yourdomain.com>
